{
  "name": "data-structure-visualizer",
  "version": "1.0.0",
  "description": "An interactive and responsive tool for visualizing data structures and algorithms",
  "main": "index.js",
  "sideEffects": [
    "*.css",
    "*.scss",
    "src/setupTests.ts",
    "src/index.tsx"
  ],
  "scripts": {
    "start": "react-scripts start",
    "start:prod": "cross-env NODE_ENV=production REACT_APP_ENABLE_MONITORING=true react-scripts start",
    "build": "react-scripts build",
    "build:prod": "cross-env NODE_ENV=production webpack --config webpack.config.prod.js",
    "build:optimized": "cross-env NODE_ENV=production craco build",
    "build:analyze": "cross-env ANALYZE=true npm run build:prod",
    "build:stats": "npm run build:optimized -- --stats",
    "build:production": "cross-env NODE_ENV=production npm run build:optimized",
    "serve:prod": "serve -s build -l 3000 --cors",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --watchAll=false --ci",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:unit": "cross-env jest --testPathPattern=test --passWithNoTests",
    "test:integration": "cross-env jest --testPathPattern=integration --passWithNoTests",
    "test:components": "cross-env jest --testPathPattern=components --passWithNoTests",
    "test:utils": "cross-env jest --testPathPattern=utils --passWithNoTests",
    "test:e2e": "cross-env jest --testPathPattern=e2e --passWithNoTests",
    "test:performance": "cross-env jest --testPathPattern=performance --passWithNoTests",
    "test:accessibility": "cross-env jest --testPathPattern=accessibility --passWithNoTests",
    "test:memory": "cross-env NODE_ENV=test jest --testPathPattern=memory --detectLeaks",
    "test:all": "cross-env jest --coverage --verbose --passWithNoTests",
    "audit:security": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "audit:a11y": "pa11y http://localhost:3000",
    "audit:lighthouse": "lighthouse http://localhost:3000 --output html --output-path ./lighthouse-report.html",
    "monitor:performance": "node scripts/performance-monitor.js",
    "monitor:errors": "node scripts/error-monitor.js",
    "monitor:memory": "node scripts/memory-monitor.js",
    "test:clear-cache": "cross-env jest --clearCache",
    "test:clear-cache-hard": "cross-env rimraf node_modules/.cache/jest && jest --clearCache",
    "test:reset": "cross-env rimraf coverage node_modules/.cache/jest && jest --clearCache",
    "eject": "react-scripts eject",
    "analyze": "node scripts/analyze-bundle.js",
    "build:analyze:report": "npm run build:analyze && npm run analyze",
    "serve": "serve -s build -l 3000",
    "serve:analyze": "npm run build:analyze:report && npm run serve",
    "clean": "rimraf build dist coverage node_modules/.cache",
    "clean:deps": "rimraf node_modules package-lock.json && npm install",
    "clean:deps:secure": "rimraf node_modules package-lock.json && npm install --no-legacy-peer-deps",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .tsx,.ts --max-warnings 0",
    "lint:fix": "eslint src --ext .tsx,.ts --fix",
    "optimize": "node scripts/optimize-bundle.js",
    "detect-circular-deps": "node scripts/detect-circular-deps.js",
    "fix-deps": "node scripts/fix-dependencies.js",
    "precommit": "npm run lint && npm run type-check && npm run test:coverage",
    "deploy:staging": "npm run build:prod && npm run serve:prod",
    "deploy:production": "npm run audit:security && npm run test:all && npm run build:prod"
  },
  "dependencies": {
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.27.1",
    "@babel/plugin-transform-numeric-separator": "^7.27.1",
    "@babel/plugin-transform-optional-chaining": "^7.27.1",
    "@babel/plugin-transform-private-methods": "^7.27.1",
    "@babel/plugin-transform-private-property-in-object": "^7.27.1",
    "@jridgewell/sourcemap-codec": "^1.4.8",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/fabric": "^5.3.10",
    "ajv": "^8.17.1",
    "fabric": "^6.7.1",
    "framer-motion": "^10.12.18",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "react-router-dom": "^6.14.1",
    "react-scripts": "5.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "styled-components": "^6.0.4"
  },
  "overrides": {
    "nth-check": "^2.1.1",
    "postcss": "^8.4.31",
    "prismjs": "^1.30.0",
    "webpack-dev-server": "^5.2.1",
    "svgo": "^3.0.0",
    "glob": "^10.3.10",
    "rimraf": "^6.0.1",
    "source-map": "^0.7.4",
    "typescript": "^4.9.5",
    "eslint": "^9.15.0",
    "puppeteer": "^24.9.0",
    "tar-fs": "^3.1.1",
    "@humanwhocodes/config-array": "npm:@eslint/config-array@^0.18.0",
    "@humanwhocodes/object-schema": "npm:@eslint/object-schema@^2.1.4",
    "rollup-plugin-terser": "npm:@rollup/plugin-terser@^0.4.4",
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@craco/craco": "^7.1.0",
    "@eslint/config-array": "^0.18.0",
    "@eslint/js": "^9.15.0",
    "@eslint/object-schema": "^2.1.4",
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "babel-jest": "^29.7.0",
    "compression-webpack-plugin": "^11.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-webpack-plugin": "^5.0.2",
    "globals": "^15.12.0",
    "gzip-size": "^7.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-axe": "^9.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jest-styled-components": "^7.2.0",
    "jest-transform-stub": "^2.0.0",
    "jest-watch-typeahead": "^2.2.2",
    "lighthouse": "^12.2.1",
    "pa11y": "^8.0.0",
    "puppeteer": "^24.9.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^4.9.5",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
